# Renew — environment variables
# Copy to .env.local and fill in. NEXT_PUBLIC_* are exposed to the browser;
# everything else is server-only and must never be committed.

# App
NEXT_PUBLIC_APP_NAME=Renew
# Production is https://getrenew.in (set in Vercel). Use localhost for local dev.
NEXT_PUBLIC_APP_URL=https://getrenew.in
NEXT_PUBLIC_PARENT_COMPANY=Zap
# The ONE owner/host email. Only this signed-in account can open the owner
# console (users, sign-ins, security). Leave blank to disable it for everyone.
NEXT_PUBLIC_OWNER_EMAIL=

# REN's LLM brain (optional). Set BOTH to turn on full natural-language + voice
# tool-calling; leave blank and Ren runs on the deterministic on-device engine.
# ANTHROPIC_API_KEY is server-only (never exposed). NEXT_PUBLIC_REN_LLM=1 tells
# the client to route Ren through the server orchestrator.
ANTHROPIC_API_KEY=
REN_MODEL=claude-3-5-haiku-latest
NEXT_PUBLIC_REN_LLM=

# Firebase (client) — from your Firebase web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server) — a service-account JSON, single-line stringified
FIREBASE_SERVICE_ACCOUNT_KEY=

# Session signing (any long random string)
AUTH_SECRET=

# Cloudinary (documents storage)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (OTP / transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Renew <onboarding@resend.dev>

# Stripe (optional — billing is Free-plan only until configured)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase (Postgres for future relational data; runs ALONGSIDE Firebase).
# Publishable (anon) key is RLS-protected and browser-safe. The service-role key
# is server-only and must never reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (payments — pay-through-Renew). Test keys need NO KYC; real money
# needs KYC (PAN + bank) in the Razorpay dashboard. Key ID is publishable; the
# secret is server-only and must never reach the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Observability (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
