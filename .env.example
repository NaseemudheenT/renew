# Renew — environment (Hostinger target). Copy to .env.local and fill in.
# NEVER commit real secrets. Names/placeholders only.

# ---- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Renew
NEXT_PUBLIC_APP_URL=https://getrenew.in
NEXT_PUBLIC_PARENT_COMPANY=Zap
NEXT_PUBLIC_OWNER_EMAIL=owner@example.com

# ---- Database: Hostinger MySQL --------------------------------------------
# Either set DATABASE_URL, or the discrete DB_* vars (DATABASE_URL wins).
DATABASE_URL=mysql://user:password@host:3306/renew
DB_HOST=localhost
DB_PORT=3306
DB_USER=renew
DB_PASSWORD=
DB_NAME=renew
DB_POOL_LIMIT=10

# ---- Auth (application-owned sessions) ------------------------------------
# Long random string; signs/derives session tokens. Required.
AUTH_SECRET=

# ---- Private file storage (Hostinger filesystem, OUTSIDE the web root) -----
# Absolute path where user documents are stored; must persist across deploys.
RENEW_STORAGE_DIR=/home/USER/renew-storage

# ---- Ren AI (server-only) --------------------------------------------------
ANTHROPIC_API_KEY=
REN_MODEL=claude-haiku-4-5-20251001
NEXT_PUBLIC_REN_LLM=1

# ---- Email (Resend, server-only) ------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Renew <hello@getrenew.in>

# ---- Payments -------------------------------------------------------------
# No payment provider is wired yet. Premium pay-in will use the founder's HDFC
# merchant/gateway when ready. Stripe kept only if genuinely used later.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Optional analytics / error tracking ----------------------------------
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- LEGACY (Firebase) — required ONLY until the MySQL cutover completes ----
# Remove these once the app runs fully on MySQL. Firebase is being migrated out.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Firebase Admin service account (JSON, single line) — also used by the one-time
# Firebase -> MySQL data migration script (scripts/migrate-firebase-to-mysql).
FIREBASE_SERVICE_ACCOUNT_KEY=
